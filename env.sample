# URL base del servicio de transacciones para desarrollo local con `npm run dev`
# Ejemplo: http://localhost:8080
TRANSACTIONS_HOST=

# Alias opcional para exponer la misma URL vía Vite en desarrollo.
VITE_TRANSACTIONS_HOST=

# URL base del servicio de analytics para desarrollo local.
# Ejemplo: http://localhost:8081
ANALYTICS_HOST=

# Variable soportada para el host de analytics en .env de Vite.
VITE_ANALYTICS_HOST=

# Host del servicio bank/middleware.
# Ejemplo: http://localhost:8082
BANK_HOST=

# Variable actual usada por este frontend para el servicio bank.
VITE_BANK_HOST=
